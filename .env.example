# ProjectSetu Environment Variables Template
# Copy to apps/web/.env for frontend configuration

# Firebase Client Configuration (Optional if running standalone demo mock)
VITE_FIREBASE_API_KEY=AIzaSySyntheticDemoKeyForProjectSetu2026
VITE_FIREBASE_AUTH_DOMAIN=project-setu-sih.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=project-setu-sih
VITE_FIREBASE_STORAGE_BUCKET=project-setu-sih.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=102938475612
VITE_FIREBASE_APP_ID=1:102938475612:web:9876543210abcdef

# Execution Mode
# If true, connects to local Firebase Emulators (Auth :9099, Firestore :8080, Storage :9199)
VITE_USE_EMULATORS=false

# If true or when Firebase cannot connect, uses persistent built-in simulation layer with realistic indexed persistence
VITE_USE_LOCAL_MOCK=false

# ML Inference Microservice endpoint
VITE_ML_SERVICE_URL=http://localhost:8000
ACTIVE_MODEL_VERSION=v1.2.0-xgb
RISK_POLICY_VERSION=v1.0.0-mospi
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
